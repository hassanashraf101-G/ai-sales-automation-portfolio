      "id": "336be3e6-e23b-4134-987e-09c6db120715",
      "name": "Get Leads to Invite",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        100
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Conservative daily cap to protect the LinkedIn account\nconst limit = $('Config').first().json.daily_invite_limit;\nreturn $input.all().filter(i => i.json.linkedin_url).slice(0, limit).map(i => {\n  const m = String(i.json.linkedin_url).match(/linkedin\\.com\\/in\\/([^/?#]+)/);\n  return { json: { ...i.json, public_identifier: m ? decodeURIComponent(m[1]) : '' } };\n}).filter(i => i.json.public_identifier);"
      },
      "id": "b10453cf-8eb7-48cd-90aa-0b92f048d343",
      "name": "Pick Today's Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.unipile_base_url }}/users/{{ $json.public_identifier }}?account_id={{ $('Config').first().json.unipile_account_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a76f59e8-e5e2-49b8-b3ad-a52445294bd4",
