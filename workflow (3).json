      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 1024, temperature: 0.7, system: \"You write LinkedIn connection request notes for a sales professional who sells real estate to buyers and investors in the Middle East. Use one specific detail from the prospect's profile (role, company, location or headline). Rules: max 200 characters, no pitch, no links, no emojis, no flattery, sound like a real person. Return JSON with key: note. Respond with the JSON object only, no other text.\", messages: [ { role: 'user', content: JSON.stringify({ sender: $('Config').first().json.sender_name, prospect: { name: $json.first_name + ' ' + $json.last_name, headline: $json.headline, location: $json.location } }) } ] }) }}",
        "options": {}
      },
      "id": "b20e7977-410f-493e-88db-d8bfac31387c",
      "name": "Claude: Write Connection Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const claudeJson = r => { const t = (r.content && r.content[0] && r.content[0].text) || ''; return JSON.parse(t.slice(t.indexOf('{'), t.lastIndexOf('}') + 1)); };\nconst batch = $('Pick Today\\'s Batch').all();\nconst profiles = $('Get LinkedIn Profile').all();\nreturn $input.all().map((item, i) => {\n  let note = ''; try { note = claudeJson(item.json).note || ''; } catch (e) {}\n  return { json: { ...batch[i].json, provider_id: profiles[i].json.provider_id, note: note.slice(0, 200) } };\n}).filter(x => x.json.provider_id);"
      },
