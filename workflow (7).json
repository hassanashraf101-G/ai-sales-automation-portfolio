      "id": "bf509847-3513-4759-8bfe-4fc481cfffee",
      "name": "Config + Normalize Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 1024, temperature: 0.4, system: \"You qualify inbound leads for a real estate product sold to buyers and investors in the Middle East (UAE, Saudi Arabia, Qatar and the wider GCC). Score the lead from 0 to 100 on how likely they are to buy in the next 90 days, using budget, timeline, purpose (investment or end use), property type, area and message. Missing information lowers confidence, not automatically the score. Return JSON only with keys: score (integer), tier ('hot' | 'warm' | 'cold'), reasons (array of max 3 short strings), whatsapp_line (one friendly sentence under 25 words that references something specific the lead said, no emojis, no pressure), email_subject (under 8 words), email_body (under 90 words, plain text, ends by proposing a 15-minute call), next_best_action (one short sentence for the sales rep). Respond with the JSON object only, no other text.\", messages: [ { role: 'user', content: JSON.stringify({ name: $json.name, country: $json.country, budget: $json.budget, area: $json.area, property_type: $json.property_type, timeline: $json.timeline, purpose: $json.purpose, message: $json.message, source: $json.source }) } ] }) }}",
        "options": {}
      },
      "id": "e985248b-9186-4bc9-8518-8d05bd1bb3fc",
      "name": "AI Qualify + Personalize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Claude returns text in content[0].text; pull out the JSON object\nconst claudeJson = r => { const t = (r.content && r.content[0] && r.content[0].text) || ''; return JSON.parse(t.slice(t.indexOf('{'), t.lastIndexOf('}') + 1)); };\n// Merge the lead with the AI's scoring and messages\nconst leads = $('Config + Normalize Lead').all();\nreturn $input.all().map((item, i) => {\n  let ai = {};\n  try { ai = claudeJson(item.json); } catch (e) { ai = { score: 0, tier: 'cold', reasons: ['AI response could not be parsed'] }; }\n  const lead = leads[i].json;\n  return { json: { ...lead, ...ai, score: Number(ai.score) || 0, reasons: (ai.reasons || []).join('; '), received_at: new Date().toISOString() } };\n});"
      },
      "id": "eb88b033-0570-469b-b9fe-29070d7ff610",
      "name": "Parse AI Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: [ { idProperty: 'email', id: $json.email, properties: { email: $json.email, firstname: $json.first_name, phone: $json.phone, country: $json.country, hs_lead_status: $json.tier === 'hot' ? 'OPEN' : 'NEW', ai_lead_score: $json.score, ai_lead_tier: $json.tier, ai_score_reasons: $json.reasons, ai_next_best_action: $json.next_best_action, lead_source_detail: $json.source } } ] }) }}",
        "options": {}
      },
